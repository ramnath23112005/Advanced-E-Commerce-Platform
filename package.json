    "test:e2e": "playwright test",
    "test:coverage": "vitest --coverage",
    "queue:dev": "tsx queue/worker.ts",
    "ci": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "@stripe/react-stripe-js": "^3.1.0",
