    "@tanstack/react-query": "^5.62.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "cloudinary": "^2.5.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "ioredis": "^5.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.2.0",
    "next-auth": "^4.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.0",
    "resend": "^4.1.0",
