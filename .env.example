# Database (PostgreSQL - required for Vercel/Render)
DATABASE_URL="postgresql://user:password@host:5432/ecommerce"
DIRECT_URL="postgresql://user:password@host:5432/ecommerce"

# Redis (Render Redis or Upstash)
REDIS_URL="redis://host:6379"

# NextAuth
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="generate-a-random-64-char-string"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# Resend (email)
RESEND_API_KEY="re_..."
